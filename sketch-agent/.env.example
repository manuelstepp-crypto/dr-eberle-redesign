# Kopieren nach .env und Werte eintragen: cp .env.example .env

# Pflicht: die beiden API-Keys
DEEPGRAM_API_KEY=dg_xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional
PORT=3000

# Deepgram-Streaming-Modell und Sprache
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=de

# Anthropic-Modell fuer den Sketch-Agent
ANTHROPIC_MODEL=claude-opus-5
# Effort des Agenten: low ist fuer den schnellen Zeichen-Loop meist ideal
SKETCH_EFFORT=low
